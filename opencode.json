{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "mercadopago": {
      "type": "remote",
      "url": "https://mcp.mercadopago.com/mcp",
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true,
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  }
}
